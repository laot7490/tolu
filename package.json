{
	"name": "@laot/tolu",
	"version": "0.2.0",
	"description": "Convert TypeScript types to EmmyLua annotations.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/laot7490/tolu.git"
	},
	"author": "laot",
	"keywords": [
		"typescript",
		"lua",
		"emmylua",
		"fivem",
		"vite",
		"codegen"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"tolu": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"prepublishOnly": "npm run build && npm test"
	},
	"dependencies": {
		"chokidar": "^5.0.0",
		"commander": "^11.0.0",
		"fast-glob": "^3.3.3",
		"ts-morph": "^25.0.1"
	},
	"peerDependencies": {
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.13.10",
		"tsup": "^8.4.0",
		"typescript": "^5.8.2",
		"vite": "^6.2.2",
		"vitest": "^3.0.9"
	},
	"engines": {
		"node": ">=18"
	}
}
